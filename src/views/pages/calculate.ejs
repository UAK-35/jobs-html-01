                                <input disabled class="wpx-50" data-last-value="<%= extensionTypes[i8].defaultQuantity %>" type="number" min="1" id="extensionTypeQ<%= i8 %>" name="extensionTypeQ<%= i8 %>" value="<%= extensionTypes[i8].defaultQuantity %>">
