            </div>
        </div>

        <div class="ceiling-types-container d-none-not-imp quote-page-card card wpct-32 float-end clear-end ms-6">
            <div class="card-header bg-light-green-2">
                <h5 class="fw-bold">Ceiling Refurbishment</h5>
            </div>
            <div class="card-body">
