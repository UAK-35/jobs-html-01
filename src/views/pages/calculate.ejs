                                <input disabled class="wpx-50" data-last-value="<%= floorRefurbTypes[i5].defaultQuantity %>" type="number" min="1" id="floorTypeQ<%= i5 %>" name="floorTypeQ<%= i5 %>" value="<%= floorRefurbTypes[i5].defaultQuantity %>">
                                <label class="" for="floorTypeQ<%= i5 %>"><%= floorRefurbTypes[i5].units %></label>
                            </div>
