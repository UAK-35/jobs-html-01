                <h5 class="fw-bold">Extensions</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-horizont has-sqm-units">
                    <% for (var i8 = 0; i8 < extensionTypes.length; i8++) { %>
                        <li class="list-group-item">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input extension-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= extensionTypes[i8].pricePounds %>" type="checkbox" id="extensionType<%= i8 %>" name="extensionType<%= i8 %>" value="<%= extensionTypes[i8].title %>">
                                <label class="form-check-label fw-medium ps-1" for="extensionType<%= i8 %>"><span><%= extensionTypes[i8].title %></span></label>
                            </div>
