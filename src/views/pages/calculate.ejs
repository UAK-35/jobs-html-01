                            <div class="d-inline-block text-end">
                                <input disabled class="wpx-50" data-last-value="<%= kitchenRefurbTypes[i4].defaultQuantity %>" type="number" min="1" id="ktchnTypeQ<%= i4 %>" name="ktchnTypeQ<%= i4 %>" value="<%= kitchenRefurbTypes[i4].defaultQuantity %>">
                                <label class="" for="ktchnTypeQ<%= i4 %>"><%= kitchenRefurbTypes[i4].units %></label>
                            </div>
