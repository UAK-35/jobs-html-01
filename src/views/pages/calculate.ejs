                            <div class="d-inline-block text-end">
                                <input disabled class="wpx-50" data-last-value="<%= ceilingRefurbTypes[i6].defaultQuantity %>" type="number" min="1" id="ceilingTypeQ<%= i6 %>" name="ceilingTypeQ<%= i6 %>" value="<%= ceilingRefurbTypes[i6].defaultQuantity %>">
