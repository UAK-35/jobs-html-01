        <div id="timeDurationSelectionContainer" class="duration-selection-container d-none quote-page-card card wpct-33">
            <div class="card-header bg-light-green-2">
                <h5 class="fw-bold">Time on Starting the Job</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <% for (var i = 0; i < workDurationTypes.length; i++) { %>
                        <li class="list-group-item">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input work-dur-type-ckbx" type="checkbox" id="workDurType<%= i %>" name="workDurType<%= i %>" value="<%= workDurationTypes[i].title %>">
                                <label class="form-check-label fw-medium ps-1" for="workDurType<%= i %>"><%= workDurationTypes[i].title %></label>
                            </div>
                        </li>
                    <% } %>
                </ul>
            </div>
            <p class="card-text p-5 fw-medium">Calculated Price: <span class="display-5 fw-bolder">&pound; <b id="calc-price">0</b></span></p>
            <div class="card-footer">
                <h5>Minimum Order Price: &pound; 200</h5>
            </div>
        </div>

        <div id="formContainer" class="data-submit-container d-none quote-page-card card wpct-65">
            <div class="card-header bg-light-green-2">
                <h5 class="fw-bold">Request your quote</h5>
            </div>
            <div class="card-body">
                <form action="" class="w-100 d-flex flex-column justify-content-start align-items-center gap-3">
                    <div class="form-floating w-100">
                        <input type="text" id="name" name="name" class="form-control" placeholder="John Doe" />
                        <label for="name">Name</label>
                    </div>
                    <div class="form-floating w-100">
                        <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" />
                        <label for="email">Email address</label>
                    </div>
                    <div class="form-floating w-100">
                        <input type="tel" id="phone" name="phone" class="form-control" placeholder="1231231231" />
                        <label for="phone">Phone</label>
                    </div>
                    <div class="form-floating w-100">
                        <!--<input type="text" id="address" name="address" class="form-control" />-->
                        <textarea name="address" id="address" cols="80" rows="3" class="form-control" placeholder="1231231231"></textarea>
                        <label for="address">Address</label>
                    </div>
                    <div class="form-1">
                        <button type="submit" class="request-quote-btn btn btn-light-green-1 btn-large">Submit</button>
                    </div>
                </form>
            </div>
            <div class="card-footer">
                <h5>We value your privacy and will not share your information.</h5>
            </div>
        </div>

