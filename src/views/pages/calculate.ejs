<div class="content-wrapper outer-container w-100 min1-vh-100 my-0 mx-auto d-flex flex-column gap-3 gap-sm-5 text-custom-black-1">

    <h1>Calculate your quote</h1>

    <div class="container d-flex flex-row justify-content-between align-content-center flex-wrap column-gap-3 row-gap-4 w-100 border-0 border-danger">

        <div class="job-types-container quote-page-card card wpct-48">
            <div class="card-header bg-light-green-2">
                <h5 class="fw-bold">My Job</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <!-- help link: https://stackoverflow.com/a/38371978 -->
                    <% for (var i = 0; i < jobTypes.length; i++) { %>
                        <li class="list-group-item">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input job-type-ckbx" type="checkbox" id="jobType<%= i %>" name="jobType<%= i %>" value="<%= jobTypes[i].value %>" />
                                <label class="form-check-label fw-medium ps-1" for="jobType<%= i %>"><%= jobTypes[i].title %></label>
                            </div>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="bathroom-types-container d-none quote-page-card card wpct-48">
            <div class="card-header bg-light-green-2">
                <h5 class="fw-bold">Bathroom Refurbishment</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list1-group-flush flex-row justify-content-between align-items-center gap-1">
                    <% for (var i = 0; i < bathroomRefurbTypes.length; i++) { %>
                        <li class="list-group-item w-100 wpct-sm-48 px-1">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bathrm-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= bathroomRefurbTypes[i].pricePounds %>" type="checkbox" id="bathrmType<%= i %>" name="bathrmType<%= i %>" value="<%= bathroomRefurbTypes[i].title %>">
                                <label class="form-check-label fw-medium ps-1" for="bathrmType<%= i %>"><%= bathroomRefurbTypes[i].title %></label>
                                <input class="w-45px" data-last-value="<%= bathroomRefurbTypes[i].defaultQuantity %>" type="number" min="1" id="bathrmTypeQ<%= i %>" name="bathrmTypeQ<%= i %>" value="<%= bathroomRefurbTypes[i].defaultQuantity %>">
                                <label class="" for="bathrmTypeQ<%= i %>"><%= bathroomRefurbTypes[i].units %></label>
                            </div>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>

