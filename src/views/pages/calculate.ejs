                        <li class="list-group-item">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input left-conv-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= loftConversionTypes[i7].pricePounds %>" type="checkbox" id="loftConvType<%= i7 %>" name="loftConvType<%= i7 %>" value="<%= loftConversionTypes[i7].title %>">
                                <label class="form-check-label fw-medium ps-1" for="loftConvType<%= i7 %>"><span><%= loftConversionTypes[i7].title %></span></label>
