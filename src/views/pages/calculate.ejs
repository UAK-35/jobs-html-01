                                <input class="form-check-input floor-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= floorRefurbTypes[i5].pricePounds %>" type="checkbox" id="floorType<%= i5 %>" name="floorType<%= i5 %>" value="<%= floorRefurbTypes[i5].title %>">
                                <label class="form-check-label fw-medium ps-1" for="floorType<%= i5 %>"><span><%= floorRefurbTypes[i5].title %></span></label>
