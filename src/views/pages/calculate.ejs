            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <% for (var i = 0; i < loftConversionTypes.length; i++) { %>
                        <li class="list-group-item">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input left-conv-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= loftConversionTypes[i].pricePounds %>" type="checkbox" id="loftConvType<%= i %>" name="loftConvType<%= i %>" value="<%= loftConversionTypes[i].title %>">
                                <label class="form-check-label fw-medium ps-1" for="loftConvType<%= i %>"><%= loftConversionTypes[i].title %></label>
                                <input class="w-45px" data-last-value="<%= loftConversionTypes[i].defaultQuantity %>" type="number" min="1" id="loftConvTypeQ<%= i %>" name="loftConvTypeQ<%= i %>" value="<%= loftConversionTypes[i].defaultQuantity %>">
