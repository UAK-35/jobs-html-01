                                <input class="form-check-input ceiling-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= ceilingRefurbTypes[i6].pricePounds %>" type="checkbox" id="ceilingType<%= i6 %>" name="ceilingType<%= i6 %>" value="<%= ceilingRefurbTypes[i6].title %>">
                                <label class="form-check-label fw-medium ps-1" for="ceilingType<%= i6 %>"><span><%= ceilingRefurbTypes[i6].title %></span></label>
