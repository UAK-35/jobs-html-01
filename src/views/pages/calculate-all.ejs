                                    <input disabled class="wpx-50" data-last-value="<%= ceilingRefurbTypes[i8].defaultQuantity %>" type="number" min="1" id="ceilingTypeQ<%= i8 %>" name="ceilingTypeQ<%= i8 %>" value="<%= ceilingRefurbTypes[i8].defaultQuantity %>">
