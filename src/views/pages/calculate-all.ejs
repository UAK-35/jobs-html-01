<div class="content-wrapper outer-container w-100 min1-vh-100 my-0 mx-auto d-flex flex-column justify-content-center gap-3 gap-sm-5 text-custom-black-1">

    <!--<div class="container w-100 mw-sm-100 d-flex flex-column gap-1 mt-5">
        <h1>Calculate your quote</h1>
        <p class="fs-6">Easily understand the labor costs for your project with our straightforward calculation process.</p>
    </div>-->

    <div class="container w-100 mw-sm-100 d-flex flex-column gap-1 mt-5">
        <h1>Calculate your quote</h1>
        <ul class="list-group list-group-dashed">
            <li class="list-group-item border-0 p-0"><span class="fs-6">Tick any job in <strong>'My Job'</strong> box below to highlight the breakdown of the work.</span></li>
            <li class="list-group-item border-0 p-0"><span class="fs-6">Input your quantities into the cell and get the price at the bottom.</span></li>
            <li class="list-group-item border-0 p-0"><span class="fs-6">Once happy with the price input your details and <strong>'Submit'</strong> the quote.</span></li>
        </ul>
    </div>

    <%- include(partialsFolder + "\\calculateLegend.ejs") %>

    <div class="container w-100 mw-sm-100 d-flex flex-column flex-wrap flex-sm-row justify-content-sm-between p-0 p-lg-3">

        <div class="container w-100 wpct-sm-49 wpct-lg-40 m-0 m-lg-2 quantities-container d-flex flex-column justify-content-start align-content-between flex-wrap column-gap-3 row-gap-4 w-100 border-0 border-danger">

            <div class="job-types-container quote-page-card card w-100">
                <div class="card-header bg-light-green-2">
                    <h5 class="fw-bold">My Job</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-vert">
                        <!-- help link: https://stackoverflow.com/a/38371978 -->
                        <% for (var i1 = 0; i1 < jobTypes.length; i1++) { %>
                        <%if (jobTypes[i1].title.length > 0) { %>
                            <li class="list-group-item has-no-quantity">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input job-type-ckbx" type="checkbox" id="jobType<%= i1 %>" name="jobType<%= i1 %>" data-service-group-name="<%= jobTypes[i1].title %>" value="<%= jobTypes[i1].value %>" />
                                    <label class="form-check-label fw-medium ps-1" for="jobType<%= i1 %>"><%= jobTypes[i1].title %></label>
                                </div>
                            </li>
                        <% } %>
                        <% } %>
                    </ul>
                </div>
            </div>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: wallRefurbTypes, listLength: wallRefurbTypes.length, idPrefix: "wallsType",
                groupTitle: "Walls Refurbishment", groupClasses: "walls-types-container",
                widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
            }) %>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: floorRefurbTypes, listLength: floorRefurbTypes.length, idPrefix: "floorType",
                groupTitle: "Floor Refurbishment", groupClasses: "floors-types-container",
                widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
            }) %>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: ceilingRefurbTypes, listLength: ceilingRefurbTypes.length, idPrefix: "ceilingType",
                groupTitle: "Ceiling Refurbishment", groupClasses: "ceiling-types-container d-none d-sm-block d1-xl-none",
                widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
            }) %>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: loftConversionTypes, listLength: loftConversionTypes.length, idPrefix: "loftConverType",
                groupTitle: "Loft Conversion", groupClasses: "loft-types-container d-none d-sm-block d1-xl-none",
                widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
            }) %>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: extensionTypes, listLength: extensionTypes.length, idPrefix: "extensnType",
                groupTitle: "Extensions", groupClasses: "extension-types-container d-none d-sm-block d-lg-none",
                widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
            }) %>

        </div>

        <div class="container w-100 wpct-sm-49 wpct-lg-56 m-0 m-lg-2 quantities-container d-flex flex-row justify-content-between align-content-start flex-wrap column-gap-3 row-gap-4 w-100 border-0 border-danger">

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: bathroomRefurbTypes, listLength: bathroomRefurbTypes.length, idPrefix: "bathrmType",
                groupTitle: "Bathroom Refurbishment", groupClasses: "bathroom-types-container",
                widthPercent: 100, listGroupClasses: "list-group-horiz has-sqm-units"
            }) %>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: kitchenRefurbTypes, listLength: kitchenRefurbTypes.length, idPrefix: "ktchnType",
                groupTitle: "Kitchen Refurbishment", groupClasses: "kitchen-types-container",
                widthPercent: 100, listGroupClasses: "list-group-horiz has-sqm-units"
            }) %>

            <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                list: ceilingRefurbTypes, listLength: ceilingRefurbTypes.length, idPrefix: "ceilingTyp",
                groupTitle: "Ceiling Refurbishment", groupClasses: "ceiling-types-container d-block d-sm-none d1-xl-block wpct-sm-48",
                widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
            }) %>

            <div class="w-100 wpct1-xl-48 d-flex flex-column">

                <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                    list: extensionTypes, listLength: extensionTypes.length, idPrefix: "extensionType",
                    groupTitle: "Extensions", groupClasses: "extension-types-container d-block d-sm-none d-lg-block",
                    widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
                }) %>

                <%- include(viewsFolder + "\\makeServiceGroup.ejs", {
                    list: loftConversionTypes, listLength: loftConversionTypes.length, idPrefix: "loftConvType",
                    groupTitle: "Loft Conversion", groupClasses: "loft-types-container d-block d-sm-none d1-xl-block",
                    widthPercent: 100, listGroupClasses: "list-group-vert has-sqm-units"
                }) %>

            </div>

        </div>

    </div>

    <div class="container d-inline-flex flex-column justify-content-start align-items-center flex-lg-row justify-content-lg-between align-items-lg-stretch flex-wrap column-gap-3 row-gap-4 w-100 mw-sm-100 mb-10 border-0 border-danger">

        <%- include(partialsFolder + "\\workDurationSection.ejs") %>

        <%- include(partialsFolder + "\\formSection.ejs") %>

    </div>

</div>
