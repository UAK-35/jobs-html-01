                                <div class="d-inline-block text-end">
                                    <input disabled class="wpx-50" data-last-value="<%= wallRefurbTypes[i2].defaultQuantity %>" type="number" min="1" id="wallsTypeQ<%= i2 %>" name="wallsTypeQ<%= i2 %>" value="<%= wallRefurbTypes[i2].defaultQuantity %>">
                                    <label class="" for="wallsTypeQ<%= i2 %>"><%= wallRefurbTypes[i2].units %></label>
                                </div>
