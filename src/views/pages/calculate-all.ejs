    <div class="container w-100 mw-sm-100 d-flex flex-column gap-1 mt-5">
        <h1>Calculate your quote</h1>
        <ul class="list-group list-group-dashed">
            <li class="list-group-item border-0 p-0"><span class="fs-7">Tick any job in 'My Job' box below to highlight the breakdown of the work.</span></li>
            <li class="list-group-item border-0 p-0"><span class="fs-7">Input your quantities into the cell and get the price at the bottom.</span></li>
            <li class="list-group-item border-0 p-0"><span class="fs-7">Once happy with the price, input your details, and 'Submit' the quote.</span></li>
        </ul>
    </div>

    <div class="container w-100 mw-sm-100 d-flex flex-column gap-1 mt-5">
        <h5>Quantity units:</h5>
        <!--<ul>
            <li><span>*sqm - square meter</span></li>
            <li><span>*p - pieces</span></li>
            <li><span>*m - meter</span></li>
        </ul>-->
        <table class="table table-bordered fs-7" style="width: 300px;">
            <tbody>
            <tr>
                <td>*sqm</td>
                <td>square meter</td>
            </tr>
            <tr>
                <td>*p</td>
                <td>pieces</td>
            </tr>
            <tr>
                <td>*m</td>
                <td>meter</td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="container w-100 mw-sm-100 d-flex flex-column flex-sm-row flex-wrap p-0 p-lg-3">

        <div class="container w-100 wpct-sm-48 wpct-lg-31 m-0 m-lg-2 quantities-container d-flex flex-column justify-content-start align-content-between flex-wrap column-gap-3 row-gap-4 w-100 border-0 border-danger">

            <div class="job-types-container quote-page-card card w-100">
                <div class="card-header bg-light-green-2">
                    <h5 class="fw-bold">My Job</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-vert">
                        <!-- help link: https://stackoverflow.com/a/38371978 -->
                        <% for (var i1 = 0; i1 < jobTypes.length; i1++) { %>
                        <%if (jobTypes[i1].title.length > 0) { %>
                            <li class="list-group-item has-no-quantity">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input job-type-ckbx" type="checkbox" id="jobType<%= i1 %>" name="jobType<%= i1 %>" value="<%= jobTypes[i1].value %>" />
                                    <label class="form-check-label fw-medium ps-1" for="jobType<%= i1 %>"><%= jobTypes[i1].title %></label>
                                </div>
                            </li>
                        <% } %>
                        <% } %>
                    </ul>
                </div>
            </div>

