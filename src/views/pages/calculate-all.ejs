                                    <label class="form-check-label fw-medium ps-1" for="bathrmType<%= i6 %>"><span><%= bathroomRefurbTypes[i6].title %></span></label>
                                </div>
                                <div class="d-inline-block text-end">
                                    <input disabled class="wpx-50" data-last-value="<%= bathroomRefurbTypes[i6].defaultQuantity %>" type="number" min="1" id="bathrmTypeQ<%= i6 %>" name="bathrmTypeQ<%= i6 %>" value="<%= bathroomRefurbTypes[i6].defaultQuantity %>">
                                    <label class="" for="bathrmTypeQ<%= i6 %>"><%= bathroomRefurbTypes[i6].units %></label>
                                </div>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>

            <div class="kitchen-types-container d-none-not-imp quote-page-card card w-100">
                <div class="card-header bg-light-green-2">
                    <h5 class="fw-bold">Kitchen Refurbishment</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-horiz">
                        <% for (var i7 = 0; i7 < kitchenRefurbTypes.length; i7++) { %>
                            <li class="list-group-item">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input ktchn-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= kitchenRefurbTypes[i7].pricePounds %>" type="checkbox" id="ktchnType<%= i7 %>" name="ktchnType<%= i7 %>" value="<%= kitchenRefurbTypes[i7].title %>">
                                    <label class="form-check-label fw-medium ps-1" for="ktchnType<%= i7 %>"><span><%= kitchenRefurbTypes[i7].title %></span></label>
                                </div>
                                <div class="d-inline-block text-end">
                                    <input disabled class="wpx-50" data-last-value="<%= kitchenRefurbTypes[i7].defaultQuantity %>" type="number" min="1" id="ktchnTypeQ<%= i7 %>" name="ktchnTypeQ<%= i7 %>" value="<%= kitchenRefurbTypes[i7].defaultQuantity %>">
                                    <label class="" for="ktchnTypeQ<%= i7 %>"><%= kitchenRefurbTypes[i7].units %></label>
                                </div>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>

            <div class="ceiling-types-container d-none-not-imp d-none d-lg-block quote-page-card card w-100 wpct-sm-48">
                <div class="card-header bg-light-green-2">
                    <h5 class="fw-bold">Ceiling Refurbishment</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-vert has-sqm-units">
                        <% for (var i8 = 0; i8 < ceilingRefurbTypes.length; i8++) { %>
                            <li class="list-group-item">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input ceiling-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= ceilingRefurbTypes[i8].pricePounds %>" type="checkbox" id="ceilingType<%= i8 %>" name="ceilingType<%= i8 %>" value="<%= ceilingRefurbTypes[i8].title %>">
