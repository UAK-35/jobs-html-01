<section class="job-selection-section section d-flex flex-column justify-content-start justify1-content-center align-items-start bg-dev row-gap-2">
    <h2 class="section-title display-2 fw-bold">Select your Job</h2>
    <div class="job-grid w-100 d-flex flex-row justify-content-between justify1-content-xl-start align1-items-stretch flex-wrap column-gap-3 column-gap-xl-4 row-gap-4 px-0 pad1-x-md-1rem"
         id="jobGrid">
        <% for (var i1 = 0; i1 < jobTypes.length; i1++) { %>
        <div class="job-card ratio-90pct">
            <img src="./assets/images/icons/<%= jobTypes[i1].indexPageIcon %>" alt="" class="job-icon">
            <h4 class="job-title d-sm-none"><%= jobTypes[i1].indexPageTitle %></h4>
            <h6 class="job-description d-sm-none"><%= jobTypes[i1].indexPageDescription %></h6>
            <h4 class="job-title fnt-1 d-none d-sm-inline"><%= jobTypes[i1].indexPageTitle %></h4>
            <h5 class="job-description fnt-4 d-none d-sm-inline"><%= jobTypes[i1].indexPageDescription %></h5>
            <a href="<%= jobTypes[i1].calculateButtonUrl %>" class="calculate-btn">
                <span>Calculate</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>
        <% } %>
    </div>
</section>
