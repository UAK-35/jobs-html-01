                    <h3 class="fnt-1 fw-bold">Do you provide free quotes or consultations?</h3>
                </button>
            </h2>
            <div id="faq-2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body pt-0 pb-2">
