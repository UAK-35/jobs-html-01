<section class="faq-section section external-outer-container d-flex flex-column justify-content-start align-items-center gap-4 bg-dev">
    <div class="header-content d-flex flex-column justify-content-start align-items-center">
        <h2 class="faq-title display-2 fw-bold">FAQ</h2>
        <h3 class="faq-subtitle fnt-1 fw-medium">We understand that home renovation projects</h3>
    </div>
    <div class="accordion accordion-flush w-100" id="faqAccordion">
        <% for (var i1 = 0; i1 < faqsList.length; i1++) { %>
        <div class="accordion-item accordion-item-style-1 rounded1-3">
            <h2 class="accordion-header">
                <button class="accordion-button<%- i1 === 0 ? '' : ' collapsed' %> rounded1-3" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq-<%= i1 + 1 %>" aria-expanded="true" aria-controls="faq-<%= i1 + 1 %>">
                    <h3 class="fnt-1 fw-bold"><%= faqsList[i1].question %></h3>
                </button>
            </h2>
            <div id="faq-<%= i1 + 1 %>" class="accordion-collapse collapse<%- i1 === 0 ? ' show' : '' %>" data-bs-parent="#faqAccordion">
                <div class="accordion-body pt-0 pb-2">
                    <p class="mb-1 fnt-3 lh-lg fw-medium"><%= faqsList[i1].answer %></p>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</section>
