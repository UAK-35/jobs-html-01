<section class="stories-location-section section external-outer-container d-flex flex-column justify-content-start align-items-center bg-dev">
    <div class="stories-header section-header">
        <div class="header-content">
            <h2 class="stories-title display-5 display-md-2 fw-bold">Client Stories and Locations</h2>
        </div>
    </div>
    <div class="stories-map-area w-100  max-wpx-1152 max-hpx-900 mt-auto d-flex flex-row justify-content-center align-items-center position-relative">
        <div id="stories-map-container" class="stories-map-wrapper wpct1-70 w-100 h-100 overflow-hidden">
            <img class="object-fit-contain w-100 h-100" src="./assets/images/pics/GREATER-LONDON.jpg" alt="ALT"/>
        </div>

        <!--Pins START-->
        <% for (var i1 = 0; i1 < reviewStoriesList.length; i1++) { %>

            <!--Pin <%= i1 + 1 %> below for view on lg screen or larger-->
            <div id="location-of-review-<%= i1 + 1 %>"
                 class="stories-icon-wrapper d-none d-lg-block fix-size-60px overflow1-hidden d-flex flex-row justify-content-center align-items-center position-absolute <%= reviewStoriesList[i1].absoluteLocationClass %>">
                <button id="stories-icon-btn-wrapper-<%= i1 + 1 %>" type="button" class="btn btn-secondary bg-transparent border-0 position1-relative"
                        data-bs-toggle="popover"
                        data-bs-placement="bottom"
                        data-bs-trigger="hover"
                        data-bs-custom-class="custom-popover"
                        data-bs-title="Custom popover"
                        data-has-html-content="true"
                        data-html-content-container-id="popover-content-container-<%= i1 + 1 %>"
                        data-show-inside-container-id="stories-icon-btn-wrapper-<%= i1 + 1 %>"
                >
                    <img class="stories-icon object-fit-contain w-100 h-100" src="./assets/images/icons/Pin.svg" alt="">
                </button>
            </div>

            <!--Pin <%= i1 + 1 %> below for view on screens smaller than lg-->
            <div id="location-of-review-<%= i1 + 1 %>a"
                 class="stories-icon-wrapper d-block d-lg-none fix-size-60px overflow1-hidden d-flex flex-row justify-content-center align-items-center position-absolute <%= reviewStoriesList[i1].absoluteLocationClass %>">
                <button id="stories-icon-btn-wrapper-<%= i1 + 1 %>a" type="button" class="btn btn-secondary bg-transparent border-0 position1-relative"
                        data-bs-toggle="popover"
                        data-bs-placement="bottom"
                        data-bs-trigger="hover"
                        data-bs-custom-class="custom-popover"
                        data-bs-title="Custom popover"
                        data-has-html-content="true"
                        data-html-content-container-id="popover-content-container-<%= i1 + 1 %>"
                        data-show-inside-container-id="stories-map-container"
                >
                    <img class="stories-icon object-fit-contain w-100 h-100" src="./assets/images/icons/Pin.svg" alt="">
                </button>
            </div>

            <!--Popover Content for Pin <%= i1 + 1 %> is below-->
            <div id="popover-content-container-<%= i1 + 1 %>" style="display: none;">
                <div data-name="popover-content">
                    <div class="wpx1-925 hpx1-260 d-flex flex-column flex-xl-row border-0 border-success">
                        <div class="wpx-300 h-100 border-0 border-success">
                            <div class="wpx-300 hpx-260 rounded rounded-4 overflow-hidden">
                                <img class="approach-icon object-fit-cover1 w-100 h-100" src="./assets/images/pics/<%= reviewStoriesList[i1].imageFilename %>" alt="">
                            </div>
                        </div>
                        <div class="wpx-300 wpx-lg-624 min-hpx-260 text-secondary text-start p-4 bg-light shadow border-0 border-danger">
                            <!--<h6 class="fw-bold text-custom-black-1">Sarah Leona</h6>-->
                            <% paragraphsCount = reviewStoriesList[i1].storyParagraphs.length; %>
                            <% for (var p1 = 0; p1 < paragraphsCount; p1++) { %>
                                <p class="fs-8 fw-normal"><%- p1 === 0 ? '"' : '' %><%= reviewStoriesList[i1].storyParagraphs[p1] %><%- p1 === paragraphsCount - 1 ? '"' : '' %></p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
        <!--Pins #END#-->
    </div>
</section>
