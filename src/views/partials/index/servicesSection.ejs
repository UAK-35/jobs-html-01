<section class="services-section section d-flex flex-column justify-content-start align-items-center gap-4 bg-dev">
    <div class="header-content d-flex flex-column justify-content-start align-items-center mb-12 flex-lg-row justify-content-lg-between align-items-lg-start">
        <h2 class="section-title display-2 fw-bold w-100 wpct-lg-49">Comprehensive Home Renovation Services for You</h2>
        <div class="w-100 wpct-lg-42">
            <p class="section-description text-secondary fw-semibold lh-lg">
                Whether you're looking to update a single room or undertake a full home renovation, our team is here to help. We offer a wide range of services to meet all your
                renovation
            </p>
            <!--<button class="see-more-btn btn btn-light-green-1 btn-medium">See More</button>-->
            <h5 class="phone d-inline d-sm-none"><a href="tel:+442034355542" class="text-decoration-none calculate-btn">Call Now</a></h5>
            <h3 class="phone d-none d-sm-inline"><a href="tel:+442034355542" class="text-decoration-none calculate-btn">Call Now</a></h3>
        </div>
    </div>
    <div class="service-grid d-flex flex-row justify-content-between align-items-start align-items-lg-stretch flex-wrap gap-2 gap-sm-3 gap-md-4 flex-lg-row">
        <% for (var i1 = 0; i1 < servicesList.length; i1++) { %>
        <div class="service-card">
            <div class="services-icon-wrapper <%= iconSize1 %> overflow-hidden d-flex flex-row justify-content-center align-items-center bg-light-green-1 is-circular">
                <img class="service-icon object-fit-contain wpct-60 hpct-60" src="./assets/images/icons/services/<%= servicesList[i1].icon %>" alt="">
            </div>
            <h5 class="service-card-title"><%= servicesList[i1].title %></h5>
            <p class="fs-8 text-center"><%= servicesList[i1].description %></p>
        </div>
        <% } %>
    </div>
</section>
