<% for (var idx = 0; idx < listLength; idx++) { %>
    <li class="list-group-item">
        <div class="form-check form-check-inline">
            <input class="form-check-input bathrm-type-ckbx ckbx-with-quantity" data-price-in-pounds="<%= list[idx].pricePounds %>" type="checkbox" id="<%= idPrefix %><%= idx %>" name="<%= idPrefix %><%= idx %>" value="<%= list[idx].title %>" data-units-string="<%= list[idx].units %>" />
            <label class="form-check-label fw-medium ps-1" for="<%= idPrefix %><%= idx %>"><span><%= list[idx].title %></span></label>
        </div>
        <div  style="width: 90px">
            <div class="d-flex align-items-center gap-1 text-start">
                <div>
                    <input disabled class="wpx-50 p-1" data-last-value="<%= list[idx].defaultQuantity %>" type="number" min="1" id="<%= idPrefix %>Q<%= idx %>" name="<%= idPrefix %>Q<%= idx %>" value="<%= list[idx].defaultQuantity %>" data-related-quantity-ckbx-id="<%= idPrefix %><%= idx %>" />
                </div>
                <div class="d-flex flex-column justify-content-center">
                    <label class="min-hpx-25 lh-base" for="<%= idPrefix %>Q<%= idx %>"><%= list[idx].units %></label>
                </div>
            </div>
        </div>
    </li>
<% } %>
