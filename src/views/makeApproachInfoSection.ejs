<div class="approach-card w-100 wpct-xl-47 d-flex flex-row justify-content-start align-items-start gap-3">
    <div class="approach-icon-wrapper d-sm-none fix-size-48px overflow-hidden d-flex flex-row justify-content-center align-items-center bg-light-green-1 is-circular">
        <img class="approach-icon object-fit-contain wpct-50 hpct-50" src="./assets/images/icons/ApproachArrow.svg" alt="">
    </div>
    <div class="approach-icon-wrapper d-none d-sm-flex fix-size-50px overflow-hidden flex-row justify-content-center align-items-center bg-light-green-1 is-circular">
        <img class="approach-icon object-fit-contain wpct-50 hpct-50" src="./assets/images/icons/ApproachArrow.svg" alt="">
    </div>
    <div class="step-content d-flex flex-column gap-2">
        <span class="spacer-1 w-100 fix-hpx-4">&nbsp;</span>
        <h4 class="approach-step-title"><%= heading %></h4>
        <p class="fs-8 text-secondary fw-semibold"><%= description %></p>
    </div>
</div>
