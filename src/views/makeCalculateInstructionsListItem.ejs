<div class="step d-flex flex-row justify-content-start align-items-start gap-4">
    <div class="step-number ring1 is-circular fix-size-30px fix-size-sm-36px text-light d-flex justify-content-center align-items-center">
        <h6 class="my-auto d-sm-none"><%= index %></h6>
        <h5 class="my-auto d-none d-sm-inline"><%= index %></h5>
    </div>
    <div class="step-content d-flex flex-column">
        <h3 class="fw-bold"><%= heading %></h3>
        <p><%= description %></p>
    </div>
</div>
