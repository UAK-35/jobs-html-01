  "scripts": {
    "start": "cross-env TS_NODE_PROJECT=tsconfig.webpack.json NODE_ENV=development webpack serve --config webpack.config.dev.ts",
    "build": "cross-env TS_NODE_PROJECT=tsconfig.webpack.json NODE_ENV=production webpack --config webpack.config.prod.ts",
    "buildStaging": "cross-env TS_NODE_PROJECT=tsconfig.webpack.json NODE_ENV=staging webpack --config webpack.config.prod.ts",
    "format": "prettier --write ./src",
    "lint": "eslint",
    "versions": "node -p \"process.env.npm_package_version\" > ./src/version-npm.txt && node -p \"require('dayjs')().format('DD-MMM-YYYY, HH:mm:ss Z[Z], dddd')\" > ./src/version.txt"
  },
